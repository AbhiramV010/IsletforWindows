<Window x:Class="Islet.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Islet.App"
        xmlns:ui="clr-namespace:Islet.App.Ui"
        Title="{x:Static local:IsletInfo.Name}"
        Width="496"
        Height="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!--
      The window is fixed at the size of the largest view plus shadow room; the
      island inside it animates its own width/height/inset, so contents never reflow
      the window. Transparent window areas fall through to the apps below. The island's
      top edge sits flush with the top of the screen.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="PillBackground" Color="#F00D0D11" />
        <Color x:Key="PillBorderColor">#1FFFFFFF</Color>
        <Color x:Key="PulseColor">#FFF5A524</Color>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="TextTertiary" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#7DD3FC" />
        <SolidColorBrush x:Key="AgentClaude" Color="#E8A27C" />
        <SolidColorBrush x:Key="IdleDot" Color="#59FFFFFF" />
        <SolidColorBrush x:Key="WaitingDot" Color="#F5A524" />
        <SolidColorBrush x:Key="DoneDot" Color="#4ADE80" />
        <SolidColorBrush x:Key="ArtPlaceholder" Color="#1AFFFFFF" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <!-- Flat rounded button; the island never takes focus, so no focus visuals. -->
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AllowButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#FF0D0D11" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F21B1B21" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MaxWidth" Value="640" />
        </Style>
    </Window.Resources>

    <Grid>
        <ui:TrapezoidBorder x:Name="Pill"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Width="220"
                            Height="22"
                            BottomInset="12"
                            BottomCornerRadius="5"
                            Background="{StaticResource PillBackground}"
                            BorderThickness="1">
            <ui:TrapezoidBorder.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="Black" />
            </ui:TrapezoidBorder.Effect>

            <Grid>
                <!-- Idle: barely there, just a dot. -->
                <Grid x:Name="IdleContent">
                    <Ellipse Width="5" Height="5" Fill="{StaticResource IdleDot}" />
                </Grid>

                <!-- Media, compact: art, title · artist, play state. -->
                <Grid x:Name="MediaCompactContent" Margin="26,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="20" Height="20" CornerRadius="4" VerticalAlignment="Center"
                            Background="{StaticResource ArtPlaceholder}">
                        <Border.OpacityMask>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Border Width="20" Height="20" CornerRadius="4" Background="Black" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.OpacityMask>
                        <Image Source="{Binding Media.Art}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="12">
                        <Run Text="{Binding Media.Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <Run Text="  " />
                        <Run Text="{Binding Media.Artist, Mode=OneWay}" Foreground="{StaticResource TextTertiary}" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                               FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE769;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Media.IsPlaying}" Value="False">
                                        <Setter Property="Text" Value="&#xE768;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Agent, compact: agent · repo, and what it is doing. -->
                <Grid x:Name="AgentCompactContent" Margin="26,0" Visibility="Collapsed" DataContext="{Binding Agents}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Accent}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Current.State}" Value="Waiting">
                                        <Setter Property="Fill" Value="{StaticResource WaitingDot}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Current.State}" Value="Done">
                                        <Setter Property="Fill" Value="{StaticResource DoneDot}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="12">
                        <Run Text="{Binding Current.AgentName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AgentClaude}" />
                        <Run Text=" · " Foreground="{StaticResource TextTertiary}" />
                        <Run Text="{Binding Current.Repo, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Current.Status}" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   MaxWidth="120" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MoreBadge}" FontSize="10" FontWeight="SemiBold" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextTertiary}" />
                    </StackPanel>
                </Grid>

                <!-- Media, expanded: bigger art plus transport controls. -->
                <Grid x:Name="MediaExpandedContent" Margin="36,10,36,12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="8" VerticalAlignment="Center"
                            Background="{StaticResource ArtPlaceholder}">
                        <Border.OpacityMask>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Border Width="64" Height="64" CornerRadius="8" Background="Black" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.OpacityMask>
                        <Image Source="{Binding Media.Art}" Stretch="UniformToFill" />
                    </Border>
                    <Grid Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Media.Title}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="{Binding Media.Artist}" FontSize="12" Margin="0,1,0,0"
                                   Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="-6,4,0,0">
                            <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Content="&#xE892;"
                                    IsEnabled="{Binding Media.CanPrevious}" Click="OnPreviousClick" />
                            <Button x:Name="PlayPauseButton" IsEnabled="{Binding Media.CanPlayPause}" Click="OnPlayPauseClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Content" Value="&#xE768;" />
                                        <Setter Property="FontSize" Value="16" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Media.IsPlaying}" Value="True">
                                                <Setter Property="Content" Value="&#xE769;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;"
                                    IsEnabled="{Binding Media.CanNext}" Click="OnNextClick" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Permission card: agent, repo, tool, one-line preview, Allow / Deny. -->
                <Grid x:Name="PermissionContent" Margin="42,9,42,12" Visibility="Collapsed"
                      DataContext="{Binding Permissions}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                            <Run Text="{Binding Current.AgentName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AgentClaude}" />
                            <Run Text=" · " Foreground="{StaticResource TextTertiary}" />
                            <Run Text="{Binding Current.Repo, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" />
                        </TextBlock>
                        <Border Grid.Column="1" CornerRadius="7" Padding="6,0" Height="14" Background="#33FFFFFF"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MoreBadge}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding MoreBadge}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Current.Tool, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Grid.Row="2" Margin="0,2,0,0" FontSize="12"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextSecondary}"
                               Background="Transparent"
                               Text="{Binding Current.Preview}"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.InitialShowDelay="350"
                               ToolTipService.ShowDuration="60000">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <TextBlock Text="{Binding Current.FullText}" TextWrapping="Wrap"
                                           FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>

                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="10" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"
                                   Text="Enter allow · Esc deny" />
                        <Button Grid.Column="1" x:Name="DenyButton" Style="{StaticResource IslandButton}"
                                Content="Deny" Click="OnDenyClick" />
                        <Button Grid.Column="2" x:Name="AllowButton" Style="{StaticResource AllowButton}"
                                Margin="8,0,0,0" Content="Allow" Click="OnAllowClick" />
                    </Grid>
                </Grid>
            </Grid>
        </ui:TrapezoidBorder>
    </Grid>
</Window>
