<Window x:Class="Islet.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Islet.App"
        xmlns:ui="clr-namespace:Islet.App.Ui"
        Title="{x:Static local:IsletInfo.Name}"
        Width="496"
        Height="124"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!--
      The window is fixed at the size of the largest view plus shadow room; the
      island inside it animates its own width/height/corners, so contents never reflow
      the window. Transparent window areas fall through to the apps below. The island's
      top edge sits flush with the top of the screen.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="PillBackground" Color="#FA000000" />
        <Color x:Key="PillBorderColor">#24FFFFFF</Color>
        <Color x:Key="PulseColor">#FFFF9F0A</Color>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#99EBEBF5" />
        <SolidColorBrush x:Key="TextTertiary" Color="#4DEBEBF5" />
        <SolidColorBrush x:Key="Accent" Color="#0A84FF" />
        <SolidColorBrush x:Key="AgentClaude" Color="#E8A27C" />
        <SolidColorBrush x:Key="IdleLine" Color="#EF4444" />
        <SolidColorBrush x:Key="AlarmAmber" Color="#F5A524" />
        <SolidColorBrush x:Key="ArtPlaceholder" Color="#1AFFFFFF" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#Overpass Mono, Cascadia Mono, Consolas</FontFamily>

        <!-- Flat rounded button; the island never takes focus, so no focus visuals. -->
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AllowButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F21C1C1E" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <ui:IslandBorder x:Name="Pill"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Width="200"
                         Height="22"
                         CornerRadius="11"
                         ShoulderRadius="6"
                         Background="{StaticResource PillBackground}"
                         BorderThickness="1">
            <ui:IslandBorder.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.4" Color="Black" />
            </ui:IslandBorder.Effect>

            <Grid>
                <!-- Idle: a short red line through the middle. -->
                <Grid x:Name="IdleContent">
                    <Rectangle Width="72" Height="2" RadiusX="1" RadiusY="1" Fill="{StaticResource IdleLine}" />
                </Grid>

                <!-- Media, compact: art, title · artist, play state. -->
                <Grid x:Name="MediaCompactContent" Margin="26,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="20" Height="20" CornerRadius="4" VerticalAlignment="Center"
                            Background="{StaticResource ArtPlaceholder}">
                        <Border.OpacityMask>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Border Width="20" Height="20" CornerRadius="4" Background="Black" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.OpacityMask>
                        <Image Source="{Binding Media.Art}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="11">
                        <Run Text="{Binding Media.Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <Run Text="  " />
                        <Run Text="{Binding Media.Artist, Mode=OneWay}" Foreground="{StaticResource TextTertiary}" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                               FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE769;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Media.IsPlaying}" Value="False">
                                        <Setter Property="Text" Value="&#xE768;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Agent, compact: agent · repo, and what it is doing. -->
                <Grid x:Name="AgentCompactContent" Margin="26,0" Visibility="Collapsed" DataContext="{Binding Agents}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="11">
                        <Run Text="{Binding Current.AgentName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding Current.AgentBrush, Mode=OneWay}" />
                        <Run Text=" · " Foreground="{StaticResource TextTertiary}" />
                        <Run Text="{Binding Current.Repo, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Current.Status}" FontSize="10" Foreground="{StaticResource TextSecondary}"
                                   MaxWidth="120" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MoreBadge}" FontSize="9" FontWeight="SemiBold" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextTertiary}" />
                    </StackPanel>
                </Grid>

                <!-- Media, expanded: art, title / artist, transport controls on one row. -->
                <Grid x:Name="MediaExpandedContent" Margin="36,7,36,9" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="6" VerticalAlignment="Center"
                            Background="{StaticResource ArtPlaceholder}">
                        <Border.OpacityMask>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Border Width="40" Height="40" CornerRadius="6" Background="Black" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.OpacityMask>
                        <Image Source="{Binding Media.Art}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Media.Title}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Media.Artist}" FontSize="10" Margin="0,1,0,0"
                                   Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Content="&#xE892;"
                                IsEnabled="{Binding Media.CanPrevious}" Click="OnPreviousClick" />
                        <Button x:Name="PlayPauseButton" IsEnabled="{Binding Media.CanPlayPause}" Click="OnPlayPauseClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Content" Value="&#xE768;" />
                                    <Setter Property="FontSize" Value="16" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Media.IsPlaying}" Value="True">
                                            <Setter Property="Content" Value="&#xE769;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;"
                                IsEnabled="{Binding Media.CanNext}" Click="OnNextClick" />

                    </StackPanel>
                </Grid>

                <!-- Agent finished: "Claude is done". Click to dismiss. -->
                <Grid x:Name="AgentDoneContent" Margin="42,8,42,10" Visibility="Collapsed"
                      DataContext="{Binding Agents}" Background="Transparent"
                      MouseLeftButtonUp="OnAgentDoneClick" Cursor="Hand">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="10" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Current.AgentName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding Current.AgentBrush, Mode=OneWay}" />
                            <Run Text=" · " Foreground="{StaticResource TextTertiary}" />
                            <Run Text="{Binding Current.Repo, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" FontSize="13" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Current.DoneHeadline, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <Run Text="  " />
                            <Run Text="Go back to your session" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Windows Clock app: the stopwatch, running timer or next alarm it is showing. -->
                <Grid x:Name="ClockCompactContent" Margin="26,0" Visibility="Collapsed" DataContext="{Binding Clock}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasStopwatch, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StopwatchText}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StopwatchRunning}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasTimer, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TimerText}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TimerBadge}" Margin="6,0,0,0" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasAlarm, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE121;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource AlarmAmber}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AlarmText}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Notification: a Windows toast, shown for a few seconds. Click to dismiss. -->
                <Grid x:Name="NotificationContent" Margin="42,8,42,10" Visibility="Collapsed"
                      DataContext="{Binding Notifications}" Background="Transparent" MouseLeftButtonUp="OnNotificationClick"
                      Cursor="Hand">
                    <StackPanel VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Current.App}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" CornerRadius="7" Padding="6,0" Height="14" Margin="6,0,0,0"
                                    Background="#33FFFFFF" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MoreBadge}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding MoreBadge}" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Margin="0,4,0,0" FontSize="11" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Current.Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <Run Text="  " />
                            <Run Text="{Binding Current.Body, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock.ToolTip>
                                <ToolTip>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Current.Title, Mode=OneWay}" FontWeight="SemiBold" />
                                        <LineBreak />
                                        <Run Text="{Binding Current.Body, Mode=OneWay}" />
                                    </TextBlock>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Permission card: details on the left, Allow / Deny on the right. -->
                <Grid x:Name="PermissionContent" Margin="42,8,42,10" Visibility="Collapsed"
                      DataContext="{Binding Permissions}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <Run Text="{Binding Current.AgentName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding Current.AgentBrush, Mode=OneWay}" />
                                <Run Text=" · " Foreground="{StaticResource TextTertiary}" />
                                <Run Text="{Binding Current.Repo, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" />
                            </TextBlock>
                            <Border Grid.Column="1" CornerRadius="7" Padding="6,0" Height="14" Margin="6,0,0,0"
                                    Background="#33FFFFFF" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MoreBadge}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding MoreBadge}" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <TextBlock Margin="0,4,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Background="Transparent"
                                   ToolTipService.InitialShowDelay="350"
                                   ToolTipService.ShowDuration="60000">
                            <Run Text="{Binding Current.Headline, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <Run Text="  " />
                            <Run Text="{Binding Current.Preview, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="{Binding Current.FullText}" TextWrapping="Wrap"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Current.IsInteractive}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DenyButton" Style="{StaticResource IslandButton}"
                                    Content="Deny" Click="OnDenyClick" />
                            <Button x:Name="AllowButton" Style="{StaticResource AllowButton}"
                                    Margin="8,0,0,0" Content="Allow" Click="OnAllowClick" />
                        </StackPanel>
                        <TextBlock FontSize="9" Margin="0,3,0,0" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextTertiary}" Text="Enter allow · Esc deny" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ui:IslandBorder>
    </Grid>
</Window>
